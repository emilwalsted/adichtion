<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dk.emilwalsted.adichtion</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>adichtion</name>
  <summary>View and export LabChart recordings</summary>
  <developer id="dk.emilwalsted">
    <name>Emil Ingerslev Walsted</name>
  </developer>
  <description>
    <p>
      adichtion opens .adicht files recorded with LabChart, without LabChart. Every channel is
      shown on one time axis with the blocks laid end to end, together with the comments, the
      video recorded with a block and the definitions of calculated channels recovered from the
      data.
    </p>
    <p>
      The whole file, a block or a selected interval can be exported as LabChart-style text,
      CSV or Excel, with the video of the interval as a clip. Recordings made with LabChart for
      Mac open as well.
    </p>
  </description>
  <launchable type="desktop-id">dk.emilwalsted.adichtion.desktop</launchable>
  <provides>
    <binary>adichtion</binary>
    <mediatype>application/x-adicht</mediatype>
  </provides>
  <categories>
    <category>Science</category>
    <category>DataVisualization</category>
  </categories>
  <keywords>
    <keyword>adicht</keyword>
    <keyword>physiology</keyword>
    <keyword>recording</keyword>
    <keyword>export</keyword>
  </keywords>
  <url type="homepage">https://www.respmech.dk/adichtion.html</url>
  <url type="bugtracker">https://github.com/emilwalsted/adichtion/issues</url>
  <url type="vcs-browser">https://github.com/emilwalsted/adichtion</url>
  <screenshots>
    <screenshot type="default">
      <caption>A recording with four channels in two blocks, and its comments</caption>
      <image>https://raw.githubusercontent.com/emilwalsted/adichtion/main/packaging/flatpak/screenshots/viewer.png</image>
    </screenshot>
    <screenshot>
      <caption>Exporting the recording as text, CSV or Excel</caption>
      <image>https://raw.githubusercontent.com/emilwalsted/adichtion/main/packaging/flatpak/screenshots/export.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#ebdfbf</color>
    <color type="primary" scheme_preference="dark">#26242e</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <releases>
    <release version="1.0.0" date="2026-10-06">
      <description>
        <p>First release: the viewer, export as text, CSV or Excel, video clips and the recovered definitions of calculated channels.</p>
      </description>
      <url type="details">https://github.com/emilwalsted/adichtion/releases/tag/v1.0.0</url>
    </release>
  </releases>
</component>
